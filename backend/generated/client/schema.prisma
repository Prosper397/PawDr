generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model DogScan {
  id          String   @id @default(cuid())
  imageUrl    String?
  breed       String
  temperament String
  careTips    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
